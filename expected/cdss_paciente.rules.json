{
  "paciente.id": {"required": true, "description": "Identificador del paciente en el centro de origen (NHC, MRN)"},
  "paciente.dni": {"pattern": "([0-9]{8}|[XYZ][0-9]{7})[A-Z]", "description": "DNI o NIE"},
  "paciente.nombre": {"required": true, "case": "title"},
  "paciente.apellidos": {"required": true, "case": "title"},
  "paciente.fecha_nacimiento": {"required": true},
  "paciente.sexo": {"required": true, "enum": ["male", "female", "other", "unknown"],
                    "description": "Sexo administrativo (valores FHIR)"},
  "paciente.telefono": {"pattern": "\\+[0-9]{8,15}", "description": "Formato internacional E.164"},
  "direccion.codigo_postal": {"pattern": "[0-9]{5}", "description": "5 dígitos, conserva ceros a la izquierda"},
  "datos_clinicos.grupo_sanguineo": {"enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]},
  "datos_clinicos.peso_kg": {"unit": "kg", "range": [0.3, 400]},
  "datos_clinicos.altura_cm": {"type": "number", "unit": "cm", "range": [20, 250],
                               "description": "El ejemplo trae un entero, pero se admiten decimales"},
  "datos_clinicos.alergia": {"multiple": "join", "description": "Varias alergias separadas por '; '"},
  "datos_clinicos.medico_responsable": {"case": "title", "description": "Nombre completo del médico responsable"}
}
