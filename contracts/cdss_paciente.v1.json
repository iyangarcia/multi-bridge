{
  "name": "cdss_paciente",
  "version": 1,
  "description": "Datos del paciente que espera el sistema de ayuda a la decisión clínica (CDSS). Basado en examples/destino_expected.json.",
  "fields": [
    {"path": "paciente.id", "type": "string", "concept": "id_paciente", "required": true,
     "description": "Identificador del paciente en el centro de origen (NHC, MRN)"},
    {"path": "paciente.dni", "type": "string", "concept": "dni",
     "pattern": "([0-9]{8}|[XYZ][0-9]{7})[A-Z]",
     "description": "DNI o NIE del paciente"},
    {"path": "paciente.nombre", "type": "string", "concept": "nombre", "required": true, "case": "title",
     "description": "Nombre de pila"},
    {"path": "paciente.apellidos", "type": "string", "concept": "apellidos", "required": true, "case": "title",
     "description": "Apellidos"},
    {"path": "paciente.fecha_nacimiento", "type": "date", "concept": "fecha_nacimiento", "required": true,
     "description": "Fecha de nacimiento (ISO 8601)"},
    {"path": "paciente.sexo", "type": "string", "concept": "sexo", "required": true,
     "enum": ["male", "female", "other", "unknown"],
     "description": "Sexo administrativo (valores FHIR)"},
    {"path": "paciente.telefono", "type": "string", "concept": "telefono", "pattern": "\\+[0-9]{8,15}",
     "description": "Teléfono en formato internacional E.164"},
    {"path": "direccion.calle", "type": "string", "concept": "calle",
     "description": "Calle y número"},
    {"path": "direccion.ciudad", "type": "string", "concept": "ciudad",
     "description": "Ciudad o municipio"},
    {"path": "direccion.codigo_postal", "type": "string", "concept": "codigo_postal", "pattern": "[0-9]{5}",
     "description": "Código postal español (5 dígitos, conserva ceros a la izquierda)"},
    {"path": "datos_clinicos.grupo_sanguineo", "type": "string", "concept": "grupo_sanguineo",
     "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"],
     "description": "Grupo sanguíneo ABO y Rh"},
    {"path": "datos_clinicos.peso_kg", "type": "number", "concept": "peso", "unit": "kg", "range": [0.3, 400],
     "description": "Peso en kilogramos"},
    {"path": "datos_clinicos.altura_cm", "type": "number", "concept": "altura", "unit": "cm", "range": [20, 250],
     "description": "Altura en centímetros"},
    {"path": "datos_clinicos.alergia", "type": "string", "concept": "alergia", "multiple": "join",
     "description": "Alergias conocidas (texto; varias separadas por '; ')"},
    {"path": "datos_clinicos.medico_responsable", "type": "string", "concept": "medico", "case": "title",
     "description": "Nombre completo del médico responsable"}
  ]
}
